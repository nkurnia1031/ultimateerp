<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Keep the application root out of Laravel's compiled route table. Older
    # framework versions can serialize the root method index as HEAD-only.
    RewriteCond %{REQUEST_URI} ^(.*/public)/?$
    RewriteRule ^$ %1/login [R=302,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Never execute server-side or active-content files from public uploads.
    # This also covers suffix variants such as .php74 and .phtml, which are
    # commonly used to bypass a rule that only blocks the .php extension.
    RewriteRule ^uploads/.*\.(htaccess|htpasswd|user\.ini|ini|phps?|fla|psd|log|sh|zip|exe|pl|jsp|asp|aspx|htm|html|cgi|py|php[0-9]*|phtml|phar)$ - [NC,F,L]

    # User import files contain private workbook rows and business data.
    RewriteRule ^uploads/(user-imports|user-import-staging|expense-imports|solar-imports|bonus-ayak-import-previews|vendor-loading-imports|heavy-equipment-rate-imports|temp)(/|$) - [NC,F,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
